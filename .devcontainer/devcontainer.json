{
  "name": "Archimedes gestures",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Gesture demo", "onAutoForward": "openBrowser", "protocol": "http" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "charliermarsh.ruff"],
      "settings": { "python.testing.pytestEnabled": true }
    }
  }
}
